#!/usr/bin/env bash
# MediTrack desktop launcher — starts the GUI without a terminal.
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"

# Prefer install-time stamp (written next to the installed launcher).
if [[ -f "$SCRIPT_DIR/meditrack.home" ]]; then
  PROJECT_ROOT="$(tr -d '\n' < "$SCRIPT_DIR/meditrack.home")"
else
  # Running from the repo: packaging/linux → project root
  PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
fi

if [[ ! -f "$PROJECT_ROOT/src/run_gui.py" ]]; then
  echo "MediTrack: project not found at $PROJECT_ROOT" >&2
  echo "Re-run packaging/linux/install.sh from the MediTrack directory." >&2
  exit 1
fi

cd "$PROJECT_ROOT"

if [[ -x "$PROJECT_ROOT/.venv/bin/python" ]]; then
  PYTHON="$PROJECT_ROOT/.venv/bin/python"
elif command -v python3 >/dev/null 2>&1; then
  PYTHON="$(command -v python3)"
else
  echo "MediTrack: no Python interpreter found. Create .venv/ or install python3." >&2
  exit 1
fi

export PYTHONUNBUFFERED=1
exec "$PYTHON" "$PROJECT_ROOT/src/run_gui.py" "$@"
